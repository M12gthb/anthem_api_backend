# Copie para .env e preencha. Nunca versione o .env de verdade.

# Banco de dados local (lido pelo Docker Compose)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=troque_esta_senha
POSTGRES_DB=anthem

# API
NODE_ENV=development
PORT=3000
API_PORT=3001
# local: postgresql://USUARIO:SENHA@localhost:5433/BANCO
# Neon: connection string "pooled" (host com -pooler) terminando em ?sslmode=require
DATABASE_URL=postgresql://postgres:troque_esta_senha@localhost:5433/anthem
# em produção: no mínimo 32 caracteres (ex.: openssl rand -base64 32)
JWT_SECRET=troque_por_um_segredo_longo_e_aleatorio

# Tokens
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=7

# Cookie do refresh token
COOKIE_SAMESITE=lax
# /auth quando o front chama a API direto; /api/auth se o front usar proxy em /api
REFRESH_COOKIE_PATH=/auth

# CORS: origens do front separadas por vírgula (vazio = nenhuma origem externa)
FRONTEND_URL=http://localhost:3002

# Quantos proxies ficam na frente da API (0 local; no Render veja o README)
TRUST_PROXY=0

# Rate limit do login
LOGIN_RATE_LIMIT=5
LOGIN_RATE_TTL_MS=60000

# Banco
DB_POOL_MAX=10

# Swagger em /docs (padrão: ligado em dev, desligado em produção)
SWAGGER_ENABLED=true

# Observe (opcional): sem as chaves, a telemetria fica desligada
OBSERVE_APP_KEY=
OBSERVE_APP_SECRET=
